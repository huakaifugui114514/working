# 复制成 deploy/.env 后填写真实值（.env 已被 .gitignore 忽略，不会进仓库）
#
#   cp deploy/.env.example deploy/.env
#
# 这里的值只用于【本地开发】。生产环境的密码由部署平台注入，
# 不要复用这里的任何字符串。

# root 密码：只用于本地管理（建库、排障）
MYSQL_ROOT_PASSWORD=change-me-root

# 应用使用的库与账号（最小权限：应用不该用 root 连库）
MYSQL_DATABASE=knowflow
MYSQL_USER=knowflow
MYSQL_PASSWORD=change-me-app

# 本机映射端口。改它可以在同一台机器上跑多套环境
MYSQL_PORT=3306

# ---- M4.4 本地 AI（可选，docker compose --profile ai 使用） ----
# 如果 Docker Hub 拉不动，改成镜像站：
# QDRANT_IMAGE=docker.m.daocloud.io/qdrant/qdrant:v1.12.4
# OLLAMA_IMAGE=docker.m.daocloud.io/ollama/ollama:0.5.7
OLLAMA_PORT=11434
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
