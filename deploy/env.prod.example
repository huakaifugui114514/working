# KnowFlow 生产部署环境变量模板（复制为 deploy/.env，勿提交）
# 所有值都是占位符；生产请使用 secret manager 注入。

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=knowflow
MYSQL_USER=knowflow
MYSQL_PASSWORD=change-me-app
MYSQL_PORT=3306

# API 鉴权（prod 必填，至少 32 字节随机值）
KF_AUTH_API_KEY=change-me-api-key
# 反向代理/负载均衡暴露端口
API_PORT=8080

# LLM（Agent 必填）
KF_LLM_BASE_URL=https://api.deepseek.com
KF_LLM_MODEL=deepseek-chat
KF_LLM_API_KEY=change-me-deepseek-key
KF_LLM_TIMEOUT=60s

# embedding / 向量检索
# 生产建议指向 GPU embedding 服务或 OpenAI-compatible embedding 网关；
# host.docker.internal 在 Linux 上需要显式 host-gateway。
KF_EMBEDDING_OLLAMA_URL=http://host.docker.internal:11434
KF_EMBEDDING_MODEL=bge-m3
KF_EMBEDDING_TIMEOUT=120s
KF_EMBEDDING_BATCH_SIZE=16
KF_RETRIEVAL_MODE=hybrid

# 镜像 tag
KF_IMAGE_TAG=prod

# 构建时 Go module 代理；国内网络可改 https://goproxy.cn,direct
GOPROXY=https://proxy.golang.org,direct
# 国内网络可覆盖基础镜像：
# GO_IMAGE=docker.m.daocloud.io/library/golang:1.27.2-alpine
# RUNTIME_IMAGE=docker.m.daocloud.io/library/alpine:3.22
