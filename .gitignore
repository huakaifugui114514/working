# 编译产物与测试输出
/bin/
*.exe
*.test
*.out
coverage.out
coverage.html

# 环境变量与密钥（.env.example 例外，允许提交）
.env
.env.*
!.env.example

# 本地/环境专属配置。约定：configs/config.yaml 是"默认配置"，必须与代码里的 Default() 一致；
# 需要偏离默认值的本地配置放这里，别去改那份提交的文件
configs/config.local.yaml
configs/config.*.local.yaml

# 本地运行数据（docker-compose 挂载卷）
/data/
/tmp/
/logs/

# 编辑器与系统
.idea/
.vscode/
*.swp
.DS_Store

# 个人化的 agent 规则覆盖（不进仓库；项目规则见 AGENTS.md）
AGENTS.local.md
CLAUDE.md
CLAUDE.local.md
